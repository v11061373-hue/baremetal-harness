# Copy values into your shell or an untracked .env file.
# BareMetal Harness does not load this file automatically.
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional non-secret overrides:
BAREMETAL_HARNESS_DATA_DIR=~/.baremetal_harness
BAREMETAL_HARNESS_WORKSPACE=.
BAREMETAL_HARNESS_REQUIRE_STRONG_SANDBOX=false
BAREMETAL_HARNESS_DOCKER_IMAGE=python:3.12-slim
